<div class="dialog-form-flex" style="padding-bottom: 15px;">
  {{#if hasNoWounds}}
    {{detailedLocalisation "Dialog" "No treatable wounds"}}
  {{else}}
    <select id="woundSelector">
      {{#each wounds as |wound|}}
        {{#unless (checkEqual wound.status "treated")}}
          <option value="{{@index}}">{{itemName wound.bodyPart}}
            - {{genName "Damage"}} {{wound.damage}}
            {{genName "Bleeding"}} {{wound.bleeding}}</option>
        {{/unless}}
      {{/each}}
    </select>
  {{/if}}
</div>