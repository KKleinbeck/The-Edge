<div class="dialog-form-flex dialog-medicine" style="padding-bottom: 15px;">
  {{> systems/the_edge/templates/dialogs/medicine-wound-overview.hbs }}

  <div class="selections">
    <label for="bodyPartSelector">{{generalLocalisation "dialog" "select body part"}}</label>
    <select id="bodyPartSelector" style="width: 125px; text-align: right;">
      <option value="all">{{genName "all"}}</option>
      <option value="Head">{{actorName "head"}}</option>
      <option value="Torso">{{actorName "torso"}}</option>
      <option value="Arms">{{actorName "arms"}}</option>
      <option value="Legs">{{actorName "legs"}}</option>
    </select>
  </div>

  <div class="selections">
    <div>{{generalLocalisation "dialog" "selection"}}</div>
    <div class="output selected-wound-hook" style="width: 125px;">{{genName "None"}}</div>
  </div>
</div>