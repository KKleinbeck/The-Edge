<div style="display: flex; justify-content: space-between; padding-bottom: 2px;">
  <div style="white-space: nowrap;">{{title}}</div>
  <a title="{{ itemName 'Create' }}" data-action="createCounter"
    style="display: flex; width: 100%; justify-content: end; align-items: end; gap: 10px; padding-bottom: 7px;">
    {{ itemName "Add" }}<i class="fas fa-plus"></i>
  </a>
</div>
{{#each counters as |counter|}}
  <div style="display: flex; gap: 5px; align-items: end;">
    <input class="counter-hook" data-index="{{@index}}" type="text" data-entry="name"
      value="{{counter.name}}" style="text-align: right;"/>
    
    <a data-action="deleteModifier" data-index="{{@index}}" title="{{ itemName 'delete' }}">
      <i class="fas fa-trash"></i>
    </a>
  </div>
{{/each}}