<section
  class="tab {{tabs.effects.cssClass}}"
  data-group="primary"
  data-tab="effects"
  style="overflow-y: auto; overflow-x: hidden"
>
  <div class="effect-modifiers-hook">
    {{> systems/the_edge/templates/generic/effect-modifiers.hbs
      modifiers=item.system.effect
      definedEffects=definedEffects
      interactive=true
      title=(genName "Modifiers")
    }}
  </div>

  <hr />
  <div class="counter-group-hook">
    {{> systems/the_edge/templates/items/meta-counters.hbs
      counters=item.system.counters
      editable=true
      nColumns=2
      title=(genName "Counters")
    }}
  </div>

  <hr />
  <div class="embedded-skills-group-hook">
    {{> systems/the_edge/templates/items/meta-embedded-skills.hbs
      skills=item.system.embeddedSkills
      editable=true
      nColumns=2
      title=(itemName "Embedded Skills")
    }}
  </div>
</section>