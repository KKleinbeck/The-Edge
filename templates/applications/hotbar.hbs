<aside>
  <svg id="hotbarFrame" style="display: block; width: 100%; height: 10vw; overflow: visible" preserveAspectRatio="none">
    <path id="hotbarOutlinePath" fill="none" stroke="var(--colour-ui-main-1)" stroke-width="2"
      style="filter: drop-shadow(0 0 2px var(--colour-ui-main-1)) drop-shadow(0 0 4px var(--colour-ui-main-1));"/>

    <path id="hotbarBorderTopPath" fill="none" stroke="var(--colour-ui-main-1)" stroke-width="8"
      style="filter: drop-shadow(0 0 2px var(--colour-ui-main-1)) drop-shadow(0 0 4px var(--colour-ui-main-1));"/>
    <path id="hotbarBorderBottomPath" fill="none" stroke="var(--colour-ui-main-1)" stroke-width="8"
      style="filter: drop-shadow(0 0 2px var(--colour-ui-main-1)) drop-shadow(0 0 4px var(--colour-ui-main-1));"/>

    <path id="hotbarBackground" fill="var(--colour-ui-main-background)"/>

    <line class="animation-pulsate-glow" x1="0.1" y1="0.5" x2="0.9" y2="0.5" stroke-width="0.4" stroke="var(--colour-ui-main-1)"
      style="filter: blur(0.02px) drop-shadow(0 0 0.05px var(--colour-ui-main-1)) brightness(var(--animated-pulsate-glow));"/>
  </svg>


  <div class="hotbar-content" data-action="click">
    {{> systems/the_edge/templates/applications/hotbar/attributes.hbs}}

    {{> systems/the_edge/templates/applications/hotbar/status-bars.hbs}}

    {{> systems/the_edge/templates/applications/hotbar/proficiency.hbs}}

    {{> systems/the_edge/templates/applications/hotbar/weapon.hbs}}

    {{> systems/the_edge/templates/applications/hotbar/dynamic-field.hbs}}
  </div>
</aside>
