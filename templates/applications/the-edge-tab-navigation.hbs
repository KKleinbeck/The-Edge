<nav class="tabs the-edge-application-nav" aria-roledescription="Form Tab Navigation" data-application-part="tabs">
  {{#each tabs as |tab|}}
    <a data-action="tab" data-group="primary" data-tab="{{tab.id}}" class="tab-element {{#if tab.active}}active{{/if}}">
      <span>{{genName tab.label}}</span>
    </a>
  {{/each}}
</nav>