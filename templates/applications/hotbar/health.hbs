<div
  class="health-element health-element-hook"
  style="display: flex; height: 100%; justify-content: space-between;"
>
  <div style="display: flex; width: 75%">
    {{#if effectsScroll}}
      <div
        style="height: calc(100% - 30px); display: flex; flex-direction: column; justify-content: space-between; margin-right: 5px;"
      >
        <button
          type="button"
          data-action="scroll"
          data-type="effects"
          data-dir="down"
          style="border: none; background: none; color: white;"
        >
          &#9650;
        </button>
        <button
          type="button"
          data-action="scroll"
          data-type="effects"
          data-dir="up"
          style="border: none; background: none; color: white;"
        >
          &#9660;
        </button>
      </div>
    {{/if}}
    <div style="width: 100%;">
      {{#if (checkNotEmpty effects)}}
        {{#each effects as |effect|}}
          <div
            class="output"
            data-tooltip
            aria-label="{{effect.sources}}"
            style="text-align: left; margin-bottom: 3px; color: white; padding: 2px 5px 2px 5px;
            height: 28px; width: 100%; pointer-events: auto; white-space: nowrap; text-overflow: ellipsis;"
          >
            {{genName effect.group}}
            {{effectRequirementName effect.field effect.group}}
            {{effect.value}}
          </div>
        {{/each}}
      {{else}}
        {{detailedLocalisation "hotbar" "no effect" actor}}
      {{/if}}
    </div>
  </div>
  <div class="hotbar-wound-overview">
    <div style="position: absolute; top: 0; right: 0; height: 100%">
      {{!-- use image 1 to generate absolute reference --}}
      <img src="systems/the_edge/assets/nervous_system_background.svg" alt="Background" style="display: block; height: 100%">
      <img src="systems/the_edge/assets/nervous_system.svg" alt="Background" style="position: absolute; top: 0; right: 0; height: 100%;">
      {{#each actor.system.wounds as |wound|}}
        <div style="position: absolute; left: {{wound.coordinates.[0]}}%; top: {{wound.coordinates.[1]}}%; pointer-events: auto;">
          {{{getWoundHTML wound true}}}
        </div>
      {{/each}}
    </div>
  </div>
</div>