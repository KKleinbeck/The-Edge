<div class="hotbar-content-dynamic dynamic-field-element-hook">
  <h5 style="display: flex; gap: 10px; align-items: center; margin-bottom: 2px; width: 40%; justify-content: space-between;">
    <button class="hotbar-carousel-button" type="button" data-action="changeDynamicField" data-type="items" data-dir="decrement">
      &#9664;
    </button>
    {{#if (checkEqual dynamicField "item")}}
      {{genName "Items"}}
    {{/if}}
    {{#if (checkEqual dynamicField "health")}}
      {{genName "Health"}}
    {{/if}}
    {{#if (checkEqual dynamicField "counter")}}
      {{genName "Counters"}}
    {{/if}}
    <button class="hotbar-carousel-button" type="button" data-action="changeDynamicField" data-type="items" data-dir="increment">
      &#9654;
    </button>
  </h5>

  {{#if (checkEqual dynamicField "item")}}
    {{> systems/the_edge/templates/applications/hotbar/item.hbs}}
  {{/if}}
  {{#if (checkEqual dynamicField "health")}}
    {{> systems/the_edge/templates/applications/hotbar/health.hbs}}
  {{/if}}
  {{#if (checkEqual dynamicField "counter")}}
    {{> systems/the_edge/templates/applications/hotbar/counter.hbs}}
  {{/if}}
</div>