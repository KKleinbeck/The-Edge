<svg id="hotbarFrame" style="display: block; width: 100%; height: 10vw; overflow: visible" preserveAspectRatio="none">
  <path id="hotbarBorderTopPathThick" fill="none" stroke="var(--colour-ui-main-1)" stroke-width="8"
    style="filter: drop-shadow(0 0 2px var(--colour-ui-main-1)) drop-shadow(0 0 4px var(--colour-ui-main-1));"
    d="M 0, {{mul heightActual 0.3}} L 0, 30 L 30, 0 L {{sub (mul 0.35 widthActual) 15}}, 0 L {{mul 0.35 widthActual}}, 15 L {{mul 0.65 widthActual 15}}, 15"
    />
  <path id="hotbarBorderBottomPathThick" fill="none" stroke="var(--colour-ui-main-1)" stroke-width="8"
    style="filter: drop-shadow(0 0 2px var(--colour-ui-main-1)) drop-shadow(0 0 4px var(--colour-ui-main-1));"
    d="M {{widthActual}} {{mul 0.7 heightActual}} L {{widthActual}}, {{sub heightActual 30}} L {{sub widthActual 30}}, {{heightActual}}
      L {{add (mul 0.65 widthActual) 15}}, {{heightActual}} L {{mul widthActual 0.65}}, {{sub heightActual 15}}
      L {{mul 0.35 widthActual}}, {{sub heightActual 15}}"
    />
  <path id="hotbarBorderTopPath" fill="none" stroke="var(--colour-ui-main-1)" stroke-width="3"
    style="filter: drop-shadow(0 0 2px var(--colour-ui-main-1)) drop-shadow(0 0 4px var(--colour-ui-main-1));"
    d="M 0, {{mul heightActual 0.3}} L 0, 30 L 30, 0 L {{sub (mul 0.35 widthActual) 15}}, 0 L {{mul 0.35 widthActual}}, 15 L {{sub widthActual 15}}, 15
      L {{widthActual}}, 30, L {{widthActual}}, {{mul heightActual 0.3}}"
    />
  <path id="hotbarBorderBottomPath" fill="none" stroke="var(--colour-ui-main-1)" stroke-width="3"
    style="filter: drop-shadow(0 0 2px var(--colour-ui-main-1)) drop-shadow(0 0 4px var(--colour-ui-main-1));"
    d="M {{widthActual}} {{mul 0.7 heightActual}} L {{widthActual}}, {{sub heightActual 30}} L {{sub widthActual 30}}, {{heightActual}}
      L {{add (mul 0.65 widthActual) 15}}, {{heightActual}} L {{mul widthActual 0.65}}, {{sub heightActual 15}}
      L 15, {{sub heightActual 15}} L 0, {{sub heightActual 30}} L 0, {{mul 0.7 heightActual}}"
    />

  <path id="hotbarBackground" fill="var(--colour-ui-main-background)"
    d="M 0, 30 L 30, 0 L {{sub (mul 0.35 widthActual) 15}}, 0 L {{mul 0.35 widthActual}}, 15 L {{sub widthActual 15}}, 15
      L {{widthActual}}, 30, L {{widthActual}}, {{sub heightActual 30}} L {{sub widthActual 30}}, {{heightActual}}
      L {{add (mul 0.65 widthActual) 15}}, {{heightActual}} L {{mul widthActual 0.65}}, {{sub heightActual 15}}
      L 15, {{sub heightActual 15}} L 0, {{sub heightActual 30}} Z"
    />

  <line class="animation-pulsate-glow hotbar-separator" stroke-width="2" stroke="var(--colour-ui-secondary"
    x1="{{mul 0.18 widthActual}}" y1="10" x2="{{mul 0.18 widthActual}}" y2="{{sub heightActual 25}}"/>
  <line class="animation-pulsate-glow hotbar-separator" stroke-width="2" stroke="var(--colour-ui-secondary"
    x1="{{mul 0.34 widthActual}}" y1="10" x2="{{mul 0.34 widthActual}}" y2="{{sub heightActual 25}}"/>
  <line class="animation-pulsate-glow hotbar-separator" stroke-width="2" stroke="var(--colour-ui-secondary"
    x1="{{mul 0.50 widthActual}}" y1="25" x2="{{mul 0.50 widthActual}}" y2="{{sub heightActual 25}}"/>
  <line class="animation-pulsate-glow hotbar-separator" stroke-width="2" stroke="var(--colour-ui-secondary"
    x1="{{mul 0.66 widthActual}}" y1="25" x2="{{mul 0.66 widthActual}}" y2="{{sub heightActual 10}}"/>
</svg>
