<div class="hotbar-item-element item-element-hook" style="display: flex; height: 82%;">
  {{#if itemsScroll}}
    <div
      style="height: 100%; display: flex; flex-direction: column; justify-content: space-between; margin-right: 5px;"
    >
      <button
        class="hotbar-scroll-button"
        type="button"
        data-action="scroll"
        data-type="items"
        data-dir="down"
      >
        &#9650;
      </button>
      <button
        class="hotbar-scroll-button"
        type="button"
        data-action="scroll"
        data-type="items"
        data-dir="up"
      >
        &#9660;
      </button>
    </div>
  {{/if}}
  <div class="hotbar-double-column">
    {{#each consumables as |consumable|}}
      <button
        class="hotbar-button item-hook"
        type="button"
        data-tooltip
        aria-label="{{consumable.tooltip}}"
        data-action="useItem"
        data-item-id="{{consumable._id}}"
        data-subaction="consume"
      >
        <img
          src="{{consumable.img}}"
          title="{{consumable.name}}"
          width="24"
          height="24"
        />
        <div class="button-text">{{consumable.displayName}}</div>
      </button>
    {{/each}}
  </div>
</div>