<table class="chat-table">
{{#each item.system.effect as |modifier|}}
  <tr>
    <td>{{genName modifier.group}}</td>
    <td>{{effectRequirementName modifier.field modifier.group}}</td>
    {{#unless (checkEqual modifier.group "dynamicModifiers")}}
      <td>{{modifier.value}}</td>
    {{/unless}}
  </tr>
{{/each}}
</table>